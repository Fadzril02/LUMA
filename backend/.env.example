# ==============================================================================
# Smart Academic Assessment System - Backend Environment Configuration (.env.example)
# Copy this file to .env and replace placeholder values with your actual credentials.
# ==============================================================================

# Application Metadata
PROJECT_NAME=Smart-AA-System
COMPANY_NAME=Academic Advising
ENVIRONMENT=development
PORT=8000
API_V1_STR=/api/v1

# Supabase Credentials (Required for DB storage & transcript processing)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your_service_role_key_here
SUPABASE_JWT_SECRET=your_supabase_jwt_secret_here

# Micro-LLM Fallback (Groq / OpenRouter / OpenAI SDK compatible)
# Used strictly when regex fails on irregular transcript lines
GROQ_API_KEY=gsk_your_groq_api_key_here
LLM_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=llama-3.1-8b-instant

# CORS & Frontend Origin URL
FRONTEND_URL=http://localhost:5173
